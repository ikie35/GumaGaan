[Unit]
Description=Rubber Leaf AI Guard (Two-Stage Precision Detection & Diagnosis)
After=network-online.target multi-user.target systemd-udev-settle.service
Wants=network-online.target
Documentation=https://github.com/ikie35/GumaGaan

[Service]
Type=simple
User=ikee
Group=ikee
WorkingDirectory=/home/ikee/rubber_guard
# Give camera sensor I2C and Hailo NPU driver time to settle on cold boot
ExecStartPre=/bin/sleep 2
ExecStart="/home/ikee/rubber_guard/venv/bin/python" app.py --host 0.0.0.0 --port 5000
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10
Environment="PYTHONUNBUFFERED=1"
Environment="CAM_INDEX=0"
Environment="YOLO_OFFLINE=True"

[Install]
WantedBy=multi-user.target
